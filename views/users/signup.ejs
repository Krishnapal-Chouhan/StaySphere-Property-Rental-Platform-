<% layout("/layouts/boilerplate") %>

<style>
    /* ================================
       StaySphere Signup Page
    ================================= */

    .signup-page {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(
                circle at 15% 20%,
                rgba(32, 213, 195, 0.12),
                transparent 30%
            ),
            radial-gradient(
                circle at 85% 80%,
                rgba(255, 56, 92, 0.12),
                transparent 30%
            ),
            #0b1424;
    }

    /* Background glow */
    .signup-page::before {
        content: "";
        position: absolute;
        width: 350px;
        height: 350px;
        top: -150px;
        right: -100px;
        background: rgba(32, 213, 195, 0.10);
        filter: blur(80px);
        border-radius: 50%;
    }

    .signup-page::after {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        bottom: -150px;
        left: -100px;
        background: rgba(255, 56, 92, 0.10);
        filter: blur(80px);
        border-radius: 50%;
    }

    /* Signup card */
    .signup-card {
        width: 100%;
        max-width: 470px;
        padding: 38px;
        position: relative;
        z-index: 2;

        background: rgba(17, 30, 49, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;

        box-shadow:
            0 25px 60px rgba(0, 0, 0, 0.40),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        animation: signupFade 0.6s ease;
    }

    /* Logo */
    .signup-logo {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;

        color: #fff;
        font-size: 25px;

        background: linear-gradient(
            135deg,
            #ff385c,
            #ff4f70
        );

        box-shadow:
            0 10px 30px rgba(255, 56, 92, 0.25);
    }

    /* Heading */
    .signup-title {
        margin: 0;
        text-align: center;

        color: #f5f7fa;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .signup-title span {
        color: #20d5c3;
    }

    .signup-subtitle {
        margin: 9px 0 30px;

        text-align: center;
        color: #8492a6;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* Labels */
    .signup-label {
        display: block;
        margin-bottom: 8px;

        color: #dce3ec;
        font-size: 0.9rem;
        font-weight: 600;
    }

    /* Input wrapper */
    .input-wrapper {
        position: relative;
    }

    /* Inputs */
    .signup-input {
        width: 100%;
        height: 50px;

        padding: 0 15px;

        color: #f5f7fa;
        background: #17253a;

        border: 1px solid #263750;
        border-radius: 13px;

        outline: none;

        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            background 0.25s ease;
    }

    .signup-input::placeholder {
        color: #718096;
    }

    .signup-input:focus {
        color: #fff;
        background: #17253a;
        border-color: #20d5c3;

        box-shadow:
            0 0 0 3px rgba(32, 213, 195, 0.10);
    }

    /* Password input */
    .password-input {
        padding-right: 52px;
    }

    /* Password toggle */
    .password-toggle {
        position: absolute;
        top: 50%;
        right: 8px;

        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        transform: translateY(-50%);

        border: none;
        border-radius: 10px;

        color: #8492a6;
        background: transparent;

        cursor: pointer;

        transition: all 0.2s ease;
    }

    .password-toggle:hover {
        color: #20d5c3;
        background: rgba(32, 213, 195, 0.08);
    }

    /* Signup button */
    .btn-signup {
        width: 100%;
        height: 52px;

        margin-top: 8px;

        border: none;
        border-radius: 13px;

        color: #fff;
        background: linear-gradient(
            135deg,
            #ff385c,
            #ff4f70
        );

        font-size: 1rem;
        font-weight: 700;

        cursor: pointer;

        box-shadow:
            0 10px 25px rgba(255, 56, 92, 0.18);

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }

    .btn-signup:hover {
        transform: translateY(-2px);

        box-shadow:
            0 15px 32px rgba(255, 56, 92, 0.28);
    }

    .btn-signup:active {
        transform: translateY(0);
    }

    /* Login link */
    .login-text {
        margin: 22px 0 0;

        text-align: center;
        color: #8492a6;
        font-size: 0.9rem;
    }

    .login-text a {
        color: #20d5c3;
        font-weight: 600;
        text-decoration: none;
    }

    .login-text a:hover {
        color: #5ee7dc;
        text-decoration: underline;
    }

    /* Bootstrap validation */
    .invalid-feedback {
        margin-top: 7px;
        font-size: 0.82rem;
    }

    .signup-input.is-invalid,
    .was-validated .signup-input:invalid {
        border-color: #ff385c;
    }

    .signup-input.is-valid,
    .was-validated .signup-input:valid {
        border-color: #20d5c3;
    }

    /* Animation */
    @keyframes signupFade {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile */
    @media (max-width: 576px) {
        .signup-page {
            min-height: calc(100vh - 65px);
            padding: 30px 15px;
        }

        .signup-card {
            padding: 28px 22px;
            border-radius: 20px;
        }

        .signup-title {
            font-size: 1.7rem;
        }

        .signup-logo {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }
    }
</style>


<div class="signup-page">

    <div class="signup-card">

        <!-- Logo -->
        <div class="signup-logo">
            <i class="fa-solid fa-house"></i>
        </div>

        <!-- Heading -->
        <h1 class="signup-title">
            Join <span>StaySphere</span>
        </h1>

        <p class="signup-subtitle">
            Create your account and start exploring amazing stays.
        </p>


        <!-- Signup Form -->
        <form
            action="/signup"
            method="POST"
            class="needs-validation"
            novalidate
        >

            <!-- Username -->
            <div class="mb-3">

                <label
                    for="username"
                    class="signup-label"
                >
                    Username
                </label>

                <div class="input-wrapper">

                    <input
                        type="text"
                        id="username"
                        name="username"
                        class="signup-input"
                        placeholder="Enter your username"
                        autocomplete="username"
                        minlength="3"
                        required
                    >

                </div>

                <div class="invalid-feedback">
                    Please enter a username.
                </div>

            </div>


            <!-- Email -->
            <div class="mb-3">

                <label
                    for="email"
                    class="signup-label"
                >
                    Email
                </label>

                <div class="input-wrapper">

                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="signup-input"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>

                <div class="invalid-feedback">
                    Please enter a valid email address.
                </div>

            </div>


            <!-- Password -->
            <div class="mb-4">

                <label
                    for="password"
                    class="signup-label"
                >
                    Password
                </label>

                <div class="input-wrapper">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="signup-input password-input"
                        placeholder="Create a password"
                        autocomplete="new-password"
                        minlength="6"
                        required
                    >

                    <button
                        type="button"
                        class="password-toggle"
                        id="togglePassword"
                        aria-label="Show password"
                    >
                        <i class="fa-regular fa-eye"></i>
                    </button>

                </div>

                <div class="invalid-feedback">
                    Password must be at least 6 characters.
                </div>

            </div>


            <!-- Submit -->
            <button
                type="submit"
                class="btn-signup"
            >
                <i class="fa-solid fa-user-plus me-2"></i>
                Create Account
            </button>

        </form>


        <!-- Login -->
        <p class="login-text">
            Already have an account?
            <a href="/login">Log in</a>
        </p>

    </div>

</div>


<script>
    // Password visibility
    const togglePassword = document.getElementById("togglePassword");
    const passwordInput = document.getElementById("password");

    if (togglePassword && passwordInput) {

        togglePassword.addEventListener("click", () => {

            const isPassword =
                passwordInput.type === "password";

            passwordInput.type =
                isPassword ? "text" : "password";

            togglePassword.innerHTML = isPassword
                ? '<i class="fa-regular fa-eye-slash"></i>'
                : '<i class="fa-regular fa-eye"></i>';

            togglePassword.setAttribute(
                "aria-label",
                isPassword
                    ? "Hide password"
                    : "Show password"
            );
        });
    }
</script>