<% layout("/layouts/boilerplate") %>

<style>
    .login-page {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 15% 20%,
                rgba(20, 213, 195, 0.12),
                transparent 32%
            ),
            radial-gradient(
                circle at 85% 80%,
                rgba(255, 56, 92, 0.12),
                transparent 32%
            ),
            #0b1424;
    }

    /* Background glow */
    .login-page::before {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: rgba(20, 213, 195, 0.07);
        filter: blur(80px);
        top: -180px;
        left: -150px;
        pointer-events: none;
    }

    .login-page::after {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: rgba(255, 56, 92, 0.07);
        filter: blur(80px);
        right: -150px;
        bottom: -160px;
        pointer-events: none;
    }

    /* Login card */
    .login-card {
        width: 100%;
        max-width: 430px;
        padding: 38px;

        position: relative;
        z-index: 2;

        background: rgba(17, 30, 49, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;

        box-shadow:
            0 25px 70px rgba(0, 0, 0, 0.42),
            inset 0 1px 0 rgba(255, 255, 255, 0.03);

        animation: loginFade 0.55s ease;
    }

    @keyframes loginFade {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Logo */
    .login-logo {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 20px;

        background: linear-gradient(
            135deg,
            #ff385c,
            #ff617d
        );

        color: white;
        font-size: 29px;

        box-shadow:
            0 12px 30px rgba(255, 56, 92, 0.25);
    }

    /* Heading */
    .login-title {
        margin: 0;
        text-align: center;

        color: #f5f7fa;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .login-subtitle {
        margin: 8px 0 30px;

        text-align: center;

        color: #8492a6;
        font-size: 14px;
        line-height: 1.6;
    }

    /* Labels */
    .login-label {
        display: block;
        margin-bottom: 8px;

        color: #dce5ef;
        font-size: 14px;
        font-weight: 600;
    }

    /* Input wrapper */
    .input-wrapper {
        position: relative;
    }

    .login-input {
        width: 100%;
        height: 50px;
        padding: 0 15px;

        box-sizing: border-box;

        border: 1px solid #2a3b52;
        border-radius: 12px;

        background: #111e31;
        color: #f5f7fa;

        outline: none;

        font-size: 15px;

        transition: 0.25s ease;
    }

    .login-input::placeholder {
        color: #64748b;
    }

    .login-input:hover {
        border-color: #3c4e66;
    }

    .login-input:focus {
        border-color: #20d5c3;
        background: #122137;

        box-shadow:
            0 0 0 3px rgba(32, 213, 195, 0.10);
    }

    /* Password input */
    .password-input {
        padding-right: 48px;
    }

    .password-toggle {
        position: absolute;
        right: 14px;
        top: 50%;

        transform: translateY(-50%);

        border: none;
        background: transparent;

        color: #718198;
        cursor: pointer;

        padding: 5px;
    }

    .password-toggle:hover {
        color: #20d5c3;
    }

    /* Login button */
    .btn-login {
        width: 100%;
        height: 50px;

        margin-top: 5px;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;

        border: none;
        border-radius: 12px;

        background: linear-gradient(
            135deg,
            #ff385c,
            #ff4f70
        );

        color: white;

        font-size: 15px;
        font-weight: 600;

        cursor: pointer;

        transition: 0.25s ease;

        box-shadow:
            0 8px 24px rgba(255, 56, 92, 0.20);
    }

    .btn-login:hover {
        transform: translateY(-2px);

        box-shadow:
            0 12px 30px rgba(255, 56, 92, 0.32);
    }

    .btn-login:active {
        transform: scale(0.98);
    }

    /* Divider */
    .login-divider {
        display: flex;
        align-items: center;
        gap: 12px;

        margin: 25px 0 20px;

        color: #5f6e82;
        font-size: 12px;
    }

    .login-divider::before,
    .login-divider::after {
        content: "";
        height: 1px;
        flex: 1;

        background: rgba(255, 255, 255, 0.08);
    }

    /* Signup */
    .signup-text {
        margin: 0;

        text-align: center;

        color: #7f8da1;
        font-size: 13px;
    }

    .signup-link {
        color: #20d5c3;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
    }

    .signup-link:hover {
        color: #5ee7d9;
        text-decoration: underline;
    }

    /* Validation */
    .invalid-feedback {
        color: #ff718b;
        font-size: 12px;
        margin-top: 6px;
    }

    /* Responsive */
    @media (max-width: 576px) {

        .login-page {
            padding: 35px 15px;
        }

        .login-card {
            padding: 30px 22px;
            border-radius: 20px;
        }

        .login-logo {
            width: 60px;
            height: 60px;
            font-size: 25px;
        }

        .login-title {
            font-size: 24px;
        }

        .login-subtitle {
            font-size: 13px;
            margin-bottom: 25px;
        }
    }
</style>


<div class="login-page">

    <div class="login-card">

        <!-- Logo -->
        <div class="login-logo">
            <i class="fa-solid fa-house-chimney"></i>
        </div>

        <!-- Heading -->
        <h1 class="login-title">
            Welcome Back
        </h1>

        <p class="login-subtitle">
            Sign in to your StaySphere account
            and continue your journey.
        </p>


        <!-- Login Form -->
        <form
            action="/login"
            method="POST"
            class="needs-validation"
            novalidate
        >

            <!-- Username -->
            <div class="mb-4">

                <label
                    for="username"
                    class="login-label"
                >
                    Username
                </label>

                <div class="input-wrapper">

                    <input
                        type="text"
                        id="username"
                        name="username"
                        class="login-input"
                        placeholder="Enter your username"
                        autocomplete="username"
                        required
                    >

                </div>

                <div class="invalid-feedback">
                    Please enter your username.
                </div>

            </div>


            <!-- Password -->
            <div class="mb-4">

                <label
                    for="password"
                    class="login-label"
                >
                    Password
                </label>

                <div class="input-wrapper">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="login-input password-input"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >

                    <button
                        type="button"
                        class="password-toggle"
                        id="togglePassword"
                        aria-label="Show password"
                    >
                        <i class="fa-regular fa-eye"></i>
                    </button>

                </div>

                <div class="invalid-feedback">
                    Please enter your password.
                </div>

            </div>


            <!-- Login Button -->
            <button
                type="submit"
                class="btn-login"
            >
                <i class="fa-solid fa-right-to-bracket"></i>
                Login
            </button>

        </form>


        <!-- Divider -->
        <div class="login-divider">
            OR
        </div>


        <!-- Signup -->
        <p class="signup-text">
            Don't have an account?
            <a
                href="/signup"
                class="signup-link"
            >
                Create Account
            </a>
        </p>

    </div>

</div>


<script>
    // Password visibility
    const togglePassword = document.getElementById("togglePassword");
    const passwordInput = document.getElementById("password");

    if (togglePassword && passwordInput) {

        togglePassword.addEventListener("click", () => {

            const isPassword =
                passwordInput.type === "password";

            // passwordInput.type =
            //     isPassword ? "text" : "password";

            if (isPassword) {
    passwordInput.type = "text";
            } else {
    passwordInput.type = "password";
            }

            togglePassword.innerHTML = isPassword
                ? '<i class="fa-regular fa-eye-slash"></i>'
                : '<i class="fa-regular fa-eye"></i>';

            togglePassword.setAttribute(
                "aria-label",
                isPassword
                    ? "Hide password"
                    : "Show password"
            );
        });
    }
</script>