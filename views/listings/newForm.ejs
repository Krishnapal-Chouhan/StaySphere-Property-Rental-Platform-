<% layout("/layouts/boilerplate") %>

<style>
    /* =========================================
       StaySphere - Create Listing
    ========================================== */

    .create-listing-page {
        min-height: calc(100vh - 80px);
        padding: 45px 15px 70px;

        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 10% 15%,
                rgba(32, 213, 195, 0.10),
                transparent 28%
            ),
            radial-gradient(
                circle at 90% 80%,
                rgba(255, 56, 92, 0.10),
                transparent 30%
            ),
            #0b1424;
    }

    /* Background glow */

    .create-listing-page::before {
        content: "";

        position: absolute;

        width: 350px;
        height: 350px;

        top: -180px;
        right: -100px;

        background: rgba(32, 213, 195, 0.08);

        filter: blur(90px);
        border-radius: 50%;

        pointer-events: none;
    }

    .create-listing-page::after {
        content: "";

        position: absolute;

        width: 300px;
        height: 300px;

        bottom: -150px;
        left: -100px;

        background: rgba(255, 56, 92, 0.08);

        filter: blur(90px);
        border-radius: 50%;

        pointer-events: none;
    }


    /* =========================================
       Main Card
    ========================================== */

    .listing-form-card {
        position: relative;
        z-index: 2;

        max-width: 850px;

        margin: auto;
        padding: 35px;

        background: rgba(17, 30, 49, 0.90);

        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 24px;

        box-shadow:
            0 25px 60px rgba(0, 0, 0, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.03);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        animation: listingFade 0.6s ease;
    }


    /* =========================================
       Heading
    ========================================== */

    .form-icon {
        width: 58px;
        height: 58px;

        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 17px;

        color: #fff;

        background: linear-gradient(
            135deg,
            #ff385c,
            #ff4f70
        );

        font-size: 23px;

        box-shadow:
            0 10px 28px rgba(255, 56, 92, 0.20);
    }

    .form-title {
        margin: 0;

        color: #f5f7fa;

        font-size: 2rem;
        font-weight: 750;

        text-align: center;
        letter-spacing: -0.5px;
    }

    .form-subtitle {
        max-width: 600px;

        margin: 9px auto 32px;

        color: #8492a6;

        font-size: 0.92rem;
        line-height: 1.6;

        text-align: center;
    }


    /* =========================================
       Form Labels
    ========================================== */

    .listing-form-label {
        display: block;

        margin-bottom: 8px;

        color: #dce3ec;

        font-size: 0.9rem;
        font-weight: 600;
    }

    .required-star {
        color: #ff385c;
    }


    /* =========================================
       Inputs
    ========================================== */

    .listing-input {
        width: 100%;

        min-height: 50px;

        padding: 11px 15px;

        color: #f5f7fa;
        background: #17253a;

        border: 1px solid #263750;
        border-radius: 12px;

        outline: none;

        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            background 0.25s ease;
    }

    .listing-input::placeholder {
        color: #6f7d90;
    }

    .listing-input:focus {
        color: #fff;
        background: #17253a;

        border-color: #20d5c3;

        box-shadow:
            0 0 0 3px rgba(32, 213, 195, 0.09);
    }


    /* Textarea */

    textarea.listing-input {
        min-height: 120px;

        resize: vertical;
    }


    /* File input */

    .listing-file-input {
        padding: 10px;

        cursor: pointer;
    }

    .listing-file-input::file-selector-button {
        margin-right: 12px;

        padding: 8px 14px;

        border: none;
        border-radius: 8px;

        color: #fff;
        background: #24344d;

        font-weight: 600;

        cursor: pointer;

        transition: background 0.2s ease;
    }

    .listing-file-input::file-selector-button:hover {
        background: #20d5c3;
        color: #0b1424;
    }


    /* =========================================
       Form Sections
    ========================================== */

    .form-section {
        margin-bottom: 27px;
    }

    .form-section-title {
        display: flex;
        align-items: center;
        gap: 9px;

        margin-bottom: 17px;

        color: #f5f7fa;

        font-size: 1rem;
        font-weight: 700;
    }

    .form-section-title i {
        color: #20d5c3;
    }

    .section-divider {
        height: 1px;

        margin: 25px 0;

        background: rgba(255, 255, 255, 0.07);
    }


    /* =========================================
       Validation
    ========================================== */

    .invalid-feedback {
        margin-top: 7px;

        color: #ff637d;

        font-size: 0.8rem;
    }

    .listing-input.is-invalid,
    .was-validated .listing-input:invalid {
        border-color: #ff385c;
    }

    .listing-input.is-valid,
    .was-validated .listing-input:valid {
        border-color: #20d5c3;
    }


    /* =========================================
       Buttons
    ========================================== */

    .listing-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        gap: 11px;

        margin-top: 30px;
    }

    .listing-action-btn {
        min-height: 45px;

        padding: 9px 20px;

        border-radius: 11px;

        font-weight: 600;
    }

    .btn-back {
        color: #aab6c6;

        background: transparent;

        border: 1px solid #34445b;
    }

    .btn-back:hover {
        color: #fff;
        background: #17253a;
        border-color: #465873;
    }

    .btn-reset {
        color: #ff637d;

        background: transparent;

        border: 1px solid rgba(255, 56, 92, 0.35);
    }

    .btn-reset:hover {
        color: #fff;

        background: #ff385c;
        border-color: #ff385c;
    }

    .btn-create {
        color: #fff;

        border: none;

        background: linear-gradient(
            135deg,
            #ff385c,
            #ff4f70
        );

        box-shadow:
            0 8px 20px rgba(255, 56, 92, 0.17);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .btn-create:hover {
        color: #fff;

        transform: translateY(-2px);

        box-shadow:
            0 12px 28px rgba(255, 56, 92, 0.27);
    }


    /* =========================================
       Animation
    ========================================== */

    @keyframes listingFade {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }


    /* =========================================
       Responsive
    ========================================== */

    @media (max-width: 768px) {

        .create-listing-page {
            padding: 30px 15px 50px;
        }

        .listing-form-card {
            padding: 27px 21px;
            border-radius: 20px;
        }

        .form-title {
            font-size: 1.7rem;
        }

        .listing-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .listing-action-btn {
            width: 100%;
        }

    }


    @media (max-width: 480px) {

        .create-listing-page {
            padding: 22px 12px 40px;
        }

        .listing-form-card {
            padding: 23px 17px;
        }

        .form-icon {
            width: 52px;
            height: 52px;

            font-size: 21px;
        }

        .form-title {
            font-size: 1.55rem;
        }

    }
</style>


<div class="create-listing-page">

    <div class="container">

        <div class="listing-form-card">

            <!-- Header -->

            <div class="form-icon">
                <i class="fa-solid fa-house-circle-check"></i>
            </div>

            <h1 class="form-title">
                Create a New Listing
            </h1>

            <p class="form-subtitle">
                Add your property details and help travelers
                discover their next perfect stay.
            </p>


            <!-- Form -->

            <form
                method="POST"
                action="/listings/new"
                novalidate
                class="needs-validation"
                enctype="multipart/form-data"
            >

                <!-- ============================
                     PROPERTY INFORMATION
                ============================= -->

                <div class="form-section">

                    <div class="form-section-title">
                        <i class="fa-solid fa-house"></i>
                        Property Information
                    </div>


                    <!-- Title -->

                    <div class="mb-4">

                        <label
                            for="title"
                            class="listing-form-label"
                        >
                            Property Title
                            <span class="required-star">*</span>
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            placeholder="e.g. Luxury Villa with Mountain View"
                            class="listing-input"
                            autocomplete="off"
                            required
                        >

                        <div class="invalid-feedback">
                            Please enter a property title.
                        </div>

                    </div>


                    <!-- Description -->

                    <div>

                        <label
                            for="descrip"
                            class="listing-form-label"
                        >
                            Description
                            <span class="required-star">*</span>
                        </label>

                        <textarea
                            id="descrip"
                            name="description"
                            rows="4"
                            placeholder="Describe your property, amenities, surroundings, and what makes it special..."
                            class="listing-input"
                            required
                        ></textarea>

                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>

                    </div>

                </div>


                <div class="section-divider"></div>


                <!-- ============================
                     PROPERTY IMAGE
                ============================= -->

                <div class="form-section">

                    <div class="form-section-title">
                        <i class="fa-solid fa-image"></i>
                        Property Image
                    </div>


                    <div>

                        <label
                            for="image"
                            class="listing-form-label"
                        >
                            Upload Listing Image
                            <span class="required-star">*</span>
                        </label>

                        <input
                            type="file"
                            id="image"
                            name="listing-image"
                            class="listing-input listing-file-input"
                            accept="image/*"
                            required
                        >

                        <div class="invalid-feedback">
                            Please upload a property image.
                        </div>

                    </div>

                </div>


                <div class="section-divider"></div>


                <!-- ============================
                     LOCATION & PRICING
                ============================= -->

                <div class="form-section">

                    <div class="form-section-title">
                        <i class="fa-solid fa-location-dot"></i>
                        Location & Pricing
                    </div>


                    <div class="row">

                        <!-- Price -->

                        <div class="col-md-4 mb-4">

                            <label
                                for="price"
                                class="listing-form-label"
                            >
                                Price / Night (₹)
                                <span class="required-star">*</span>
                            </label>

                            <input
                                type="number"
                                id="price"
                                name="price"
                                placeholder="e.g. 2500"
                                class="listing-input"
                                min="1"
                                step="1"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter a valid price.
                            </div>

                        </div>


                        <!-- Location -->

                        <div class="col-md-8 mb-4">

                            <label
                                for="location"
                                class="listing-form-label"
                            >
                                Location
                                <span class="required-star">*</span>
                            </label>

                            <input
                                type="text"
                                id="location"
                                name="location"
                                placeholder="e.g. Manali, Himachal Pradesh"
                                class="listing-input"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter a valid location.
                            </div>

                        </div>

                    </div>


                    <!-- Country -->

                    <div>

                        <label
                            for="country"
                            class="listing-form-label"
                        >
                            Country
                            <span class="required-star">*</span>
                        </label>

                        <input
                            type="text"
                            id="country"
                            name="country"
                            placeholder="e.g. India"
                            class="listing-input"
                            required
                        >

                        <div class="invalid-feedback">
                            Please enter a country.
                        </div>

                    </div>

                </div>


                <!-- ============================
                     ACTIONS
                ============================= -->

                <div class="listing-form-actions">

                    <a
                        href="/listings"
                        class="btn listing-action-btn btn-back"
                    >
                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Back
                    </a>


                    <button
                        type="reset"
                        class="btn listing-action-btn btn-reset"
                    >
                        <i class="fa-solid fa-rotate-left me-2"></i>
                        Reset
                    </button>


                    <button
                        type="submit"
                        class="btn listing-action-btn btn-create"
                    >
                        <i class="fa-solid fa-plus me-2"></i>
                        Create Listing
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>