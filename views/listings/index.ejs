<% layout("/layouts/boilerplate")%>

    <style>
        :root {
            --ss-bg: #071a2a;
            --ss-panel: #0b2437;
            --ss-panel-2: #102d43;
            --ss-text: #f5fbff;
            --ss-muted: #a9bdca;
            --ss-cyan: #19e6d1;
            --ss-cyan-dark: #08b9aa;
            --ss-border: rgba(255,255,255,.12);
        }

        body {
            background:
                radial-gradient(circle at 15% 0%, rgba(25,230,209,.09), transparent 30%),
                linear-gradient(180deg, #061624 0%, #071a2a 45%, #08192a 100%);
            color: var(--ss-text);
        }

        .ss-home {
            min-height: 100vh;
            padding-bottom: 60px;
        }

        /* =========================
           HERO
        ========================= */
        .ss-hero {
            position: relative;
            width: 100vw;
            min-height: 330px;
            margin-left: calc(50% - 50vw);
            margin-right: calc(50% - 50vw);
            margin-top:-18px;
            overflow: hidden;
            display: flex;
            align-items: center;
            border-bottom: 0px solid var(--ss-border);
            background:
                linear-gradient(90deg, rgba(4,19,31,.93) 0%, rgba(4,19,31,.68) 42%, rgba(4,19,31,.12) 100%),
                url("https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2600&q=90")
                center center / cover no-repeat;
        }

        .ss-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, rgba(7,26,42,.98), transparent 48%);
            pointer-events: none;
        }

        .ss-hero-content {
            position: relative;
            z-index: 2;
            width: min(1180px, 92%);
            margin: 0 auto;
            padding: 58px 0 54px;
        }

        .ss-eyebrow {
            margin: 0 0 8px;
            color: #91c5ce;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-size: .72rem;
            font-weight: 700;
        }

        .ss-hero h1 {
            max-width: 650px;
            margin: 0;
            font-size: clamp(2.25rem, 5vw, 4.3rem);
            line-height: .98;
            font-weight: 800;
            letter-spacing: -2px;
        }

        .ss-hero h1 span {
            color: var(--ss-cyan);
        }

        .ss-hero p {
            max-width: 620px;
            margin: 18px 0 0;
            color: #c1d2dc;
            font-size: 1rem;
            line-height: 1.7;
        }

        .ss-hero-tagline {
            position: absolute;
            right: 3%;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            color: white;
            font-family: Georgia, serif;
            font-size: clamp(1.7rem, 3vw, 3rem);
            font-style: italic;
            line-height: 1.05;
            text-align: right;
            text-shadow: 0 5px 25px rgba(0,0,0,.45);
        }

        .ss-hero-tagline::after {
            content: "";
            display: block;
            width: 105px;
            height: 2px;
            margin: 12px 0 0 auto;
            background: var(--ss-cyan);
            transform: rotate(-4deg);
        }

        /* =========================
           FILTER / CATEGORY BAR
        ========================= */
        .filter-wrapper {
            position: relative;
            z-index: 5;
            background: rgba(5, 22, 35, .94);
            border-bottom: 1px solid var(--ss-border);
            backdrop-filter: blur(14px);
        }

        #filters {
            width:99%;
            height:85px;
            margin: 0 auto;

            margin-top:-20px;
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            gap: 6px;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 12px 0;
            scrollbar-width: none;
            white-space: nowrap;
        }

        #filters::-webkit-scrollbar {
            display: none;
        }

        .filter {
            width: 88px;
            min-width: 88px;
            text-align: center;
            cursor: pointer;
            color: #b9cbd5;
            opacity: .88;
            transition: all .25s ease;
            flex: 0 0 88px;
            padding: 8px 5px;
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .filter > div {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            margin-bottom: 4px;
        }

        .filter i {
            display: block;
            font-size: 1.2rem;
            line-height: 1;
        }

        .filter p {
            margin: 0;
            font-size: .72rem;
            line-height: 1.1;
            font-weight: 600;
            text-align: center;
        }

        .filter:hover,
        .filter:first-child {
            color: white;
            opacity: 0.5;
            transform: translateY(-2px);
        }

        .filter:first-child {
            background: rgba(25,230,209,.12);
            box-shadow: inset 0 0 0 1px rgba(25,230,209,.25);
        }

        .filter:first-child i {
            color: var(--ss-cyan);
        }

        .tax-toggle {
            /* margin-left: 108px; */
            margin-right:10px;
            flex: 0 0 auto;
            align-self: center;
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 13px;
            padding: 9px 13px;
            background: rgba(255,255,255,.025);
            color: #dce8ee;
            font-size: .76rem;
        }

        .tax-toggle .form-check {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .tax-toggle .form-check-input {
            float: none;
            margin: 0;
            flex-shrink: 0;
        }

        .tax-toggle .form-check-input {
            cursor: pointer;
        }

        /* =========================
           LISTINGS
        ========================= */
        .ss-listings {
            width: min(1420px, 94%);
            margin: 28px auto 0;
        }

        .ss-listings .row {
            --bs-gutter-x: 22px;
            --bs-gutter-y: 24px;
        }

        .ss-card {
            height: 100%;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 13px;
            background: linear-gradient(180deg, #102b41 0%, #0c2134 100%);
            box-shadow: 0 12px 30px rgba(0,0,0,.22);
            transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
        }

        .ss-card:hover {
            transform: translateY(-5px);
            border-color: rgba(25,230,209,.48);
            box-shadow: 0 18px 40px rgba(0,0,0,.34);
        }

        .ss-image-wrap {
            position: relative;
            height: 205px;
            overflow: hidden;
            background: #102c40;
        }

        .ss-image-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s ease;
        }

        .ss-card:hover .ss-image-wrap img {
            transform: scale(1.045);
        }

        .ss-badge {
            position: absolute;
            left: 12px;
            top: 12px;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(6,23,37,.82);
            border: 1px solid rgba(25,230,209,.35);
            color: white;
            font-size: .7rem;
            font-weight: 700;
            backdrop-filter: blur(8px);
        }

        .ss-heart {
            position: absolute;
            right: 12px;
            top: 12px;
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(4,18,30,.72);
            color: white;
            border: 1px solid rgba(255,255,255,.16);
            font-size: .95rem;
        }

        .ss-heart {
    cursor: pointer;
    transition: transform 0.2s ease;
}

.ss-heart i {
    color: #ffffff;
    transition: color 0.2s ease, transform 0.2s ease;
}

.ss-heart.active i {
    color: #ff385c;
    transform: scale(1.15);
}

        .ss-card-body {
            padding: 16px 16px 13px;
        }

        .ss-card-title {
            margin: 0 0 7px;
            color: #f5fbff;
            font-size: 1rem;
            font-weight: 750;
        }

        .ss-location {
            margin: 0 0 9px;
            color: #9db5c2;
            font-size: .76rem;
        }

        .ss-location i {
            color: var(--ss-cyan);
            margin-right: 4px;
        }

        .ss-description {
            min-height: 42px;
            margin: 0;
            color: #a9bdca;
            font-size: .78rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .ss-card-footer {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 12px;
            padding: 13px 16px 15px;
            border-top: 1px solid var(--ss-border);
        }

        .ss-price {
            color: white;
            font-size: .93rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .ss-price small {
            display: block;
            margin-top: 2px;
            color: var(--ss-cyan);
            font-size: .67rem;
            font-weight: 700;
        }

        .ss-details {
            border: 1px solid var(--ss-cyan) !important;
            color: var(--ss-cyan) !important;
            background: transparent !important;
            border-radius: 9px !important;
            padding: 7px 15px !important;
            font-size: .74rem !important;
            font-weight: 650 !important;
            transition: all .2s ease;
        }

        .ss-details:hover {
            color: #05202a !important;
            background: var(--ss-cyan) !important;
        }

        .tax-info {
            display: inline;
            color: var(--ss-cyan);
            font-style: italic;
            font-size: .78rem;
        }

        .tax-info.hidden {
            display: none;
        }

        .ss-empty {
            margin: 25px 0;
            border: 1px solid var(--ss-border);
            border-radius: 14px;
            background: rgba(255,255,255,.04);
            color: #dbe8ee;
        }

        .ss-more {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin: 34px 0 0;
            color: var(--ss-cyan);
            font-size: .8rem;
            font-weight: 700;
        }

        .ss-more::before,
        .ss-more::after {
            content: "";
            width: 48px;
            height: 2px;
            background: var(--ss-cyan);
            opacity: .7;
        }

        @media (min-width: 992px) {
            .ss-listings .col-md-4 {
                width: 33.333333%;
            }

            #filters {
                overflow-x: visible;
            }
        }

        @media (max-width: 900px) {
            .ss-hero {
                min-height: 270px;
            }

            .ss-hero-tagline {
                display: none;
            }

            .ss-image-wrap {
                height: 220px;
            }
        }

        @media (max-width: 768px) {
            .ss-hero {
                min-height: 285px;
            }

            .ss-hero-content {
                padding: 44px 0;
            }

            .ss-hero h1 {
                letter-spacing: -1px;
            }

            .tax-toggle {
                display: none;
            }

            #filters {
                width: 96%;
                justify-content: flex-start;
                gap: 4px;
                padding-left: 2px;
                padding-right: 2px;
            }

            .filter {
                width: 74px;
                min-width: 74px;
                flex-basis: 74px;
            }

            .ss-listings {
                width: 92%;
            }
        }

        @media (max-width: 575px) {
            .ss-hero {
                min-height: 250px;
            }

            .ss-hero-content {
                padding: 38px 0;
            }

            .ss-hero p {
                font-size: .87rem;
            }

            .ss-image-wrap {
                height: 200px;
            }
        }
    </style>

    <body>
        <main class="ss-home">

           
            <!-- Categories -->
            <div class="filter-wrapper">
                <div id="filters">

                    <div class="filter">
                        <div><i class="fa-solid fa-fire"></i></div>
                        <p>Trending</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-restroom"></i></div>
                        <p>Rooms</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-mountain-city"></i></div>
                        <p>Iconic City</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-mountain"></i></div>
                        <p>Mountains</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-brands fa-fort-awesome"></i></div>
                        <p>Castles</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-person-swimming"></i></div>
                        <p>Amazing Pools</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-person-swimming"></i></div>
                        <p>Amazing Pools</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-campground"></i></div>
                        <p>Camping</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-tractor"></i></div>
                        <p>Farms</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-snowflake"></i></div>
                        <p>Arctic</p>
                    </div>

                    <div class="filter">
                        <div><i class="fa-solid fa-mound"></i></div>
                        <p>Deserts</p>
                    </div>

                    <div class="tax-toggle">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox"
                                role="switch" id="switchCheckDefault">
                            <label class="form-check-label" for="switchCheckDefault">
                                Display Total After Taxes
                            </label>
                        </div>
                    </div>

                </div>
            </div>

             <!-- Hero section inspired by the provided StaySphere design -->
            <section class="ss-hero">
                <div class="ss-hero-content">
                    <p class="ss-eyebrow">Book unique stays</p>
                    <h1>Discover the World's <span>Best Places</span> to Stay</h1>
                    <p>
                        From cozy cabins to luxury villas — find a beautiful stay
                        for your next adventure.
                    </p>
                </div>

                <div class="ss-hero-tagline">
                    Better Stays<br>
                    Bigger Stories.
                </div>
            </section>


            <!-- Listings -->
            <section class="ss-listings">
                <% if(allListings.length===0){ %>
                    <div class="alert ss-empty text-center">
                        No listings found.
                    </div>
                <% } %>

                <div class="row">
                    <% for(let listing of allListings){ %>
                        <div class="col-md-4 mb-4">

                            <article class="ss-card">

                                <div class="ss-image-wrap">
                                    <a href="/listings/<%= listing._id %>" class="image-link">
                                        <img
                                            src="<%= listing.image.url || 'https://images.pexels.com/photos/29511872/pexels-photo-29511872.jpeg' %>"
                                            alt="<%= listing.title %>">
                                    </a>

                                    <span class="ss-badge">
                                       <i class="fa-regular fa-face-smile"></i> Unique Stay
                                    </span>

                                    <span class="ss-heart">
                                        <i class="fa-regular fa-heart"></i>
                                    </span>
                                </div>

                                <div class="ss-card-body">
                                    <h5 class="ss-card-title">
                                        <%= listing.title %>
                                    </h5>

                                    <p class="ss-location">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= listing.location || "Amazing destination" %>
                                        <% if(listing.country){ %>
                                            , <%= listing.country %>
                                        <% } %>
                                    </p>

                                    <p class="ss-description">
                                        <%= listing.description %>
                                    </p>
                                </div>

                                <div class="ss-card-footer">
                                    <div class="ss-price">
                                        ₹<%= listing.price?.toLocaleString("en-IN") || "N/A" %> /night
                                        <small class="tax-info">+18% GST</small>
                                    </div>

                                    <a href="/listings/<%= listing._id %>"
                                       class="btn ss-details">
                                        View Details <i class="fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                </div>

                            </article>
                        </div>
                    <% } %>
                </div>

                <% if(allListings.length > 0){ %>
                    <div class="ss-more">
                        Explore More Amazing Stays
                    </div>
                <% } %>
            </section>

        </main>
    </body>

    <script>
        const taxswitch = document.getElementById("switchCheckDefault");
        const taxInfo = document.getElementsByClassName("tax-info");

        if (taxswitch) {
            taxswitch.addEventListener("change", () => {
                for (const info of taxInfo) {
                    info.classList.toggle("hidden", !taxswitch.checked);
                }
            });
        }







            document.querySelectorAll(".ss-heart").forEach(heart => {
        heart.addEventListener("click", function () {
            this.classList.toggle("active");

            const icon = this.querySelector("i");

            if (this.classList.contains("active")) {
                icon.classList.remove("fa-regular");
                icon.classList.add("fa-solid");
            } else {
                icon.classList.remove("fa-solid");
                icon.classList.add("fa-regular");
            }
        });
    });

    </script>

</html>